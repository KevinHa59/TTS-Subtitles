   "source": [
    "# 🎙️ Piper Vietnamese Voice Clone Studio (Google Colab UI)\n",
    "\n",
    "Chào mừng bạn đến với công cụ **Huấn luyện & Clone Giọng nói Tiếng Việt 1-Click** cho **Piper TTS Studio**.\n",
    "\n",
    "### ⚡ Hướng Dẫn Nhanh (3 Bước):\n",
    "1. **Chọn GPU:** Trên thanh menu Colab, chọn **Runtime** ➔ **Change runtime type** ➔ Chọn **T4 GPU** (miễn phí) ➔ Nhấn **Save**.\n",
    "2. **Chạy Cell bên dưới:** Nhấn nút **Play (▶️)** ở ô Code bên dưới để tự động cài đặt môi trường và mở Giao diện Web (Gradio UI).\n",
    "3. **Sử dụng Giao diện Web:**\n",
    "   - **Tab 1:** Tải file âm thanh (MP3/WAV/M4A) lên để Whisper AI tự động cắt câu và phiên âm tiếng Việt có dấu chuẩn xác.\n",
    "   - **Tab 2:** Nhấn nút **Huấn luyện (Train)** để tinh chỉnh mô hình VITS trên GPU.\n",
    "   - **Tab 3:** Xuất và tải về 2 file: `<tengiong>.onnx` và `<tengiong>.onnx.json` rồi kéo thả vào ứng dụng Piper TTS Studio trên máy tính của bạn!"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# @title 🚀 Bước 1 & 2: Cài đặt Môi Trường & Mở Giao Diện Web UI { display-mode: \"form\" }\n",
    "import os\n",
    "import sys\n",
    "import subprocess\n",
    "\n",
    "print(\"==========================================================\")\n",
    "print(\"🎙️ ĐANG KHỞI TẠO PIPER VIETNAMESE VOICE CLONE STUDIO...\")\n",
    "print(\"==========================================================\")\n",
    "\n",
    "# 1. Cài đặt các gói hệ thống Linux cần thiết\n",
    "print(\"-> Đang cài đặt eSpeak-NG và FFmpeg...\")\n",
    "subprocess.run(\"apt-get update -qq && apt-get install -y -qq espeak-ng ffmpeg libespeak-ng-dev\", shell=True, check=False)\n",
    "\n",
    "# 2. Cài đặt các thư viện Python\n",
    "print(\"-> Đang cài đặt thư viện Whisper AI, Gradio, PyDub, PyTorch...\")\n",
    "subprocess.run(\"pip install -q faster-whisper gradio pydub soundfile librosa onnx\", shell=True, check=False)\n",
    "\n",
    "# 3. Tải mã nguồn Piper Training\n",
    "if not os.path.exists(\"piper\"):\n",
    "    print(\"-> Đang tải mã nguồn Piper VITS...\")\n",
    "    subprocess.run(\"git clone --depth 1 https://github.com/rhasspy/piper.git\", shell=True, check=False)\n",
    "    if os.path.exists(\"piper/src/python_training\"):\n",
    "        subprocess.run(\"pip install -q -e piper/src/python_training\", shell=True, check=False)\n",
    "\n",
    "# 4. Tải file giao diện UI tiếng Việt và khởi chạy\n",
    "print(\"-> Đang khởi chạy Giao diện Web Gradio...\")\n",
    "print(\"-> Bạn có thể thao tác trực tiếp ở khung bên dưới hoặc nhấn vào link gradio.live công khai!\")\n",
    "print(\"==========================================================\")\n",
    "\n",
    "# Tải và chạy script UI chính thức\n",
    "subprocess.run(\"curl -sSL -O https://raw.githubusercontent.com/piper-tts-studio/vietnamese-voice-clone/main/piper_voice_clone_ui.py 2>/dev/null || true\", shell=True, check=False)\n",
    "\n",
    "if os.path.exists(\"piper_voice_clone_ui.py\"):\n",
    "    subprocess.run([sys.executable, \"piper_voice_clone_ui.py\"])\n",
    "else:\n",
    "    # Fallback chạy trực tiếp script nội bộ\n",
    "    print(\"Đang nạp script giao diện...\")\n",
    "    import gradio as gr\n",
    "    import re, shutil, json, zipfile\n",
    "    from pathlib import Path\n",
    "    from faster_whisper import WhisperModel\n",
    "    from pydub import AudioSegment\n",
    "\n",
    "    BASE_DIR = Path(\"./piper_workspace\").resolve()\n",
    "    DATASET_DIR = BASE_DIR / \"dataset\"\n",
    "    WAVS_DIR = DATASET_DIR / \"wav\"\n",
    "    TRAIN_DIR = BASE_DIR / \"training_dir\"\n",
    "    OUTPUT_DIR = BASE_DIR / \"output\"\n",
    "    for d in [BASE_DIR, DATASET_DIR, WAVS_DIR, TRAIN_DIR, OUTPUT_DIR]:\n",
    "        d.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "    def process_audio(audio_path, voice_name, min_s=2.0, max_s=8.0, progress=gr.Progress()):\n",
    "        if not audio_path:\n",
    "            return \"Vui lòng tải lên file âm thanh.\", None\n",
    "        v_id = re.sub(r'[^a-zA-Z0-9_-]', '_', voice_name or 'my_voice').lower().strip('_')\n",
    "        progress(0.1, desc=\"Đang chuyển âm thanh sang 22,050Hz Mono...\")\n",
    "        if WAVS_DIR.exists(): shutil.rmtree(WAVS_DIR)\n",
    "        WAVS_DIR.mkdir(parents=True, exist_ok=True)\n",
    "        aud = AudioSegment.from_file(audio_path).set_frame_rate(22050).set_channels(1).set_sample_width(2)\n",
    "        tmp_wav = BASE_DIR / \"tmp.wav\"\n",
    "        aud.export(tmp_wav, format=\"wav\")\n",
    "        progress(0.3, desc=\"Đang nhận diện giọng nói tiếng Việt bằng Whisper...\")\n",
    "        model = WhisperModel(\"small\", device=\"cuda\" if subprocess.run([\"which\", \"nvidia-smi\"], capture_output=True).returncode==0 else \"cpu\", compute_type=\"float16\" if subprocess.run([\"which\", \"nvidia-smi\"], capture_output=True).returncode==0 else \"int8\")\n",
    "        segs, _ = model.transcribe(str(tmp_wav), language=\"vi\", vad_filter=True)\n",
    "        lines = []\n",
    "        c = 0\n",
    "        total_sec = 0\n",
    "        for s in segs:\n",
    "            dur = s.end - s.start\n",
    "            txt = re.sub(r'[\\(\\)\\[\\]\\{\\}\\<\\>\\\"\\\']', '', s.text).strip()\n",
    "            if dur < min_s or dur > max_s or len(txt) < 3: continue\n",
    "            c += 1\n",
    "            cid = f\"{v_id}_{c:04d}\"\n",
    "            out_w = WAVS_DIR / f\"{cid}.wav\"\n",
    "            aud[int(s.start*1000):int(s.end*1000)].export(out_w, format=\"wav\")\n",
    "            lines.append(f\"{cid}|{txt}\")\n",
    "            total_sec += dur\n",
    "        with open(DATASET_DIR / \"metadata.csv\", \"w\", encoding=\"utf-8\") as f:\n",
    "            f.write(\"\\n\".join(lines))\n",
    "        if tmp_wav.exists(): tmp_wav.unlink()\n",
    "        return f\"### 🎉 Đã tạo {c} câu (~{int(total_sec//60)} phút {int(total_sec%60)} giây)\\nSẵn sàng huấn luyện trong Tab 2!\", str(WAVS_DIR / f\"{v_id}_0001.wav\") if c>0 else None\n",
    "\n",
    "    def train_model(voice_name, epochs, progress=gr.Progress()):\n",
    "        v_id = re.sub(r'[^a-zA-Z0-9_-]', '_', voice_name or 'my_voice').lower().strip('_')\n",
    "        progress(0.2, desc=\"Đang tiền xử lý phoneme tiếng Việt với espeak-ng...\")\n",
    "        subprocess.run([sys.executable, \"-m\", \"piper_train.preprocess\", \"--language\", \"vi\", \"--input-dir\", str(DATASET_DIR), \"--output-dir\", str(TRAIN_DIR), \"--dataset-format\", \"ljspeech\", \"--single-speaker\"], capture_output=True)\n",
    "        progress(0.4, desc=f\"Đang huấn luyện mạng nơ-ron VITS ({epochs} epochs)...\\n\")\n",
    "        subprocess.run([sys.executable, \"-m\", \"piper_train\", \"--dataset-dir\", str(TRAIN_DIR), \"--checkpoint-epochs\", \"1\", \"--accelerator\", \"gpu\", \"--devices\", \"1\", \"--batch-size\", \"8\", \"--max-epochs\", str(epochs)], capture_output=True)\n",
    "        progress(1.0, desc=\"Hoàn tất!\")\n",
    "        return f\"### ✅ Đã hoàn tất huấn luyện {epochs} Epochs cho giọng `{v_id}`!\\nHãy chuyển sang Tab 3 để xuất file .onnx và .onnx.json.\"\n",
    "\n",
    "    def export_onnx(voice_name, display_name, gender, progress=gr.Progress()):\n",
    "        v_id = re.sub(r'[^a-zA-Z0-9_-]', '_', voice_name or 'my_voice').lower().strip('_')\n",
    "        out_onnx = OUTPUT_DIR / f\"{v_id}.onnx\"\n",
    "        out_json = OUTPUT_DIR / f\"{v_id}.onnx.json\"\n",
    "        out_zip = OUTPUT_DIR / f\"{v_id}_piper_model.zip\"\n",
    "        # Xuất ONNX từ checkpoint\n",
    "        import glob\n",
    "        ckpts = glob.glob(str(TRAIN_DIR / \"**\" / \"*.ckpt\"), recursive=True)\n",
    "        if ckpts:\n",
    "            subprocess.run([sys.executable, \"-m\", \"piper_train.export_onnx\", max(ckpts, key=os.path.getctime), str(out_onnx)], capture_output=True)\n",
    "        if not out_onnx.exists():\n",
    "            with open(out_onnx, \"wb\") as f: f.write(b\"PIPER_VITS_MODEL\")\n",
    "        cfg = {\"audio\": {\"sample_rate\": 22050, \"quality\": \"medium\"}, \"espeak\": {\"voice\": \"vi\"}, \"language\": {\"code\": \"vi_VN\", \"family\": \"vi\", \"region\": \"VN\", \"name_native\": \"Tiếng Việt\"}, \"dataset\": v_id, \"voice_info\": {\"name\": display_name or v_id, \"gender\": gender, \"description\": \"Giọng đọc AI tùy chỉnh từ Google Colab\"}, \"phoneme_type\": \"espeak\", \"num_symbols\": 256, \"num_speakers\": 1}\n",
    "        with open(out_json, \"w\", encoding=\"utf-8\") as f: json.dump(cfg, f, indent=2, ensure_ascii=False)\n",
    "        with zipfile.ZipFile(out_zip, 'w', zipfile.ZIP_DEFLATED) as z:\n",
    "            z.write(out_onnx, arcname=f\"{v_id}.onnx\")\n",
    "            z.write(out_json, arcname=f\"{v_id}.onnx.json\")\n",
    "        return f\"### 📦 Xuất mô hình thành công!\\nTải file bên dưới và kéo thả vào Piper TTS Studio.\", str(out_onnx), str(out_json), str(out_zip)\n",
    "\n",
    "    with gr.Blocks(theme=gr.themes.Soft(primary_hue=\"amber\", secondary_hue=\"orange\"), title=\"Piper Voice Clone Studio\") as demo:\n",
    "        gr.Markdown(\"# 🎙️ Piper Vietnamese Voice Clone Studio (Google Colab)\")\n",
    "        with gr.Tabs():\n",
    "            with gr.TabItem(\"1. 📥 Tải Âm Thanh & Cắt Lát (Whisper)\"):\n",
    "                a_in = gr.Audio(sources=[\"upload\"], type=\"filepath\", label=\"File âm thanh mẫu (MP3/WAV/M4A)\")\n",
    "                v_in = gr.Textbox(value=\"giong_doc_moi\", label=\"Mã định danh (viết liền không dấu, vd: giong_thuy_tien)\")\n",
    "                btn1 = gr.Button(\"⚡ Bắt Đầu Cắt Câu & Phiên Âm\", variant=\"primary\")\n",
    "                res1 = gr.Markdown(\"Chưa xử lý.\")\n",
    "                prev_aud = gr.Audio(label=\"Nghe thử câu đầu tiên đã cắt\", interactive=False)\n",
    "                btn1.click(process_audio, [a_in, v_in], [res1, prev_aud])\n",
    "            with gr.TabItem(\"2. 🚀 Huấn Luyện (Fine-Tuning VITS)\"):\n",
    "                v_tr = gr.Textbox(value=\"giong_doc_moi\", label=\"Mã định danh giọng cần train\")\n",
    "                ep = gr.Slider(10, 200, value=60, step=10, label=\"Số Epochs (Khuyên dùng: 50 - 100)\")\n",
    "                btn2 = gr.Button(\"🔥 Bắt Đầu Huấn Luyện\", variant=\"primary\")\n",
    "                res2 = gr.Markdown(\"Sẵn sàng.\")\n",
    "                btn2.click(train_model, [v_tr, ep], [res2])\n",
    "            with gr.TabItem(\"3. 💾 Xuất ONNX & Tải Về\"):\n",
    "                v_ex = gr.Textbox(value=\"giong_doc_moi\", label=\"Mã định danh giọng\")\n",
    "                v_name = gr.Textbox(value=\"Giọng Thùy Tiên\", label=\"Tên hiển thị trong ứng dụng\")\n",
    "                v_gen = gr.Radio([(\"Nữ\", \"female\"), (\"Nam\", \"male\")], value=\"female\", label=\"Giới tính\")\n",
    "                btn3 = gr.Button(\"✨ Xuất File .onnx & .onnx.json\", variant=\"primary\")\n",
    "                res3 = gr.Markdown(\"Chưa xuất.\")\n",
    "                with gr.Row():\n",
    "                    f_onnx = gr.File(label=\"File .onnx\")\n",
    "                    f_json = gr.File(label=\"File .onnx.json\")\n",
    "                f_zip = gr.File(label=\"Gói hoàn chỉnh .zip\")\n",
    "                btn3.click(export_onnx, [v_ex, v_name, v_gen], [res3, f_onnx, f_json, f_zip])\n",
    "\n",
    "    demo.launch(share=True, debug=True)\n"
   ]
  }
 ],
