                title="Di chuyá»ƒn clip sang trÃ¡i (HoÃ¡n Ä‘á»•i vá»›i clip trÆ°á»›c)"
                className="inline-flex items-center gap-1 rounded border border-sky-500/50 bg-sky-950/30 px-2 py-1 text-[11px] font-semibold text-sky-200 hover:bg-sky-900/50 disabled:opacity-40"
              >
                <MoveLeft className="h-3 w-3" />
                Dá»‹ch trÃ¡i
              </button>
              <button
                type="button"
                onClick={() => activeClipId && handleMoveClipOffset(activeClipId, 1)}
                disabled={!activeClipId || timelineClipItems.findIndex((c) => c.id === activeClipId) === timelineClipItems.length - 1}
                title="Di chuyá»ƒn clip sang pháº£i (HoÃ¡n Ä‘á»•i vá»›i clip sau)"
                className="inline-flex items-center gap-1 rounded border border-sky-500/50 bg-sky-950/30 px-2 py-1 text-[11px] font-semibold text-sky-200 hover:bg-sky-900/50 disabled:opacity-40"
              >
                <MoveRight className="h-3 w-3" />
                Dá»‹ch pháº£i
              </button>
              <button
                type="button"
                onClick={() => {
                  if (activeClipId) removeTimelineClip(activeClipId);
                  else if (activeSourceId) removeTimelineSource(activeSourceId);
                }}
                disabled={!activeClipId && !activeSourceId}
                title="XÃ³a clip Ä‘ang chá»n trÃªn timeline (Delete)"
                className="inline-flex items-center gap-1 rounded border border-rose-500/50 bg-rose-950/30 px-2 py-1 text-[11px] font-semibold text-rose-200 hover:bg-rose-900/50 disabled:opacity-40"
              >
                <Trash2 className="h-3 w-3" />
                XÃ³a clip
              </button>
              <button type="button" onClick={seekTimelineStart} disabled={!timelineClips.length} title="ÄÆ°a playhead vá» frame Ä‘áº§u cá»§a toÃ n timeline (Home)" className="rounded border border-slate-700 px-2 py-1 text-[11px] hover:border-slate-500 disabled:opacity-40">Start Frame</button>
              <button type="button" onClick={seekTimelineEnd} disabled={!timelineClips.length} title="ÄÆ°a playhead tá»›i frame cuá»‘i cá»§a toÃ n timeline" className="rounded border border-slate-700 px-2 py-1 text-[11px] hover:border-slate-500 disabled:opacity-40">End Frame</button>
              <button type="button" onClick={setCutFrom} disabled={!timelineClips.length} title="Äáº·t frame hiá»‡n táº¡i trÃªn timeline lÃ m Ä‘áº§u range" className="rounded border border-amber-400/40 px-2 py-1 text-[11px] text-amber-200 hover:bg-amber-400/10 disabled:opacity-40">Cut From Frame</button>
              <button type="button" onClick={setCutTo} disabled={!timelineClips.length} title="Äáº·t frame hiá»‡n táº¡i trÃªn timeline lÃ m cuá»‘i range" className="rounded border border-amber-400/40 px-2 py-1 text-[11px] text-amber-200 hover:bg-amber-400/10 disabled:opacity-40">Cut To Frame</button>
              <button
                type="button"
                onClick={addSplitMarker}
                disabled={!timelineClips.length}
                title={`ÄÃ¡nh dáº¥u split táº¡i playhead ${formatTime(playhead)}`}
                className="rounded border border-cyan-400/50 px-2 py-1 text-[11px] text-cyan-200 hover:bg-cyan-400/10 disabled:opacity-40"
              >
                Mark to split
              </button>
              <button
                type="button"
                onClick={removeLastSplitMarker}
                disabled={!splitMarkers.length}
                title="XÃ³a má»‘c split Ä‘Æ°á»£c thÃªm gáº§n Ä‘Ã¢y nháº¥t"
                className="rounded border border-cyan-400/30 px-2 py-1 text-[11px] text-cyan-200 hover:bg-cyan-400/10 disabled:opacity-40"
              >
                Undo mark
              </button>
              <button
                type="button"
                onClick={() => setSplitMarkers([])}
                disabled={!splitMarkers.length}
                title="XÃ³a toÃ n bá»™ má»‘c split"
                className="rounded border border-slate-700 px-2 py-1 text-[11px] text-slate-300 hover:border-slate-500 disabled:opacity-40"
              >
                Clear marks
              </button>
              <button
                type="button"
                onClick={splitTimelineToQueues}
                disabled={!splitMarkers.some((time) => time > 0 && time < timelineDuration)}
                title="Chia toÃ n bá»™ timeline tá»« Ä‘áº§u Ä‘áº¿n cuá»‘i thÃ nh cÃ¡c queue theo má»‘c Ä‘Ã£ Ä‘Ã¡nh dáº¥u"
                className="rounded bg-cyan-400 px-2.5 py-1 text-[11px] font-bold text-slate-950 hover:bg-cyan-300 disabled:opacity-40"
              >
                Split to queues
              </button>
              <div className="inline-flex items-center gap-1.5 border-l border-slate-700 pl-2 ml-1">
                <label className="flex items-center gap-1 text-[10px] text-slate-300" title="Tá»± snap frame start/end vá» keyframe gáº§n nháº¥t Ä‘á»ƒ tá»‘i Æ°u Stream-copy">
                  <input
                    type="checkbox"
                    checked={preferKeyframeCuts}
                    onChange={(e) => setPreferKeyframeCuts(e.target.checked)}
                    className="accent-sky-400"
                  />
                  Keyframe
                </label>
                <div className="ml-3">
                  <label className="text-[10px] text-slate-300">Frame Tolerance %: </label>
                  <input
                    type="number"
                    id="frameToleranceInput"
                    value={5}
                    min="1"
                    max="50"
                    step="1"
                    onChange={(e) => setFrameTolerance(parseFloat(e.target.value) || 5)}
                    className="w-20 rounded border border-sky-400/40 px-1 py-1 text-[10px] text-sky-200 focus:outline-none focus:ring-2 focus:ring-sky-500/30"
                  />
                  <label className="text-[10px] text-slate-300">Duration Tolerance %: </label>
                  <input
                    type="number"
                    id="durationToleranceInput"
                    value={5}
                    min="1"
                    max="50"
                    step="0.5"
                    onChange={(e) => setDurationTolerance(parseFloat(e.target.value) || 5)}
                    className="w-20 rounded border border-sky-400/40 px-1 py-1 text-[10px] text-sky-200 focus:outline-none focus:ring-2 focus:ring-sky-500/30"
                  />
                  <button
                    type="button"
                    onClick={() => setFrameTolerance(5) && setDurationTolerance(5)}
                    className="rounded border border-sky-400/40 px-1 py-1 text-[10px] text-sky-200 hover:bg-sky-950/40 disabled:opacity-40"
                    title="Äáº·t vá» giÃ¡ trá»‹ máº·c Ä‘á»‹nh (5%)"
                  >
                    Default
                  </button>
                </div>
                <button
                  type="button"
                  onClick={addActiveClipToQueue}
                  disabled={!activeClipId || !timelineClips.length}
