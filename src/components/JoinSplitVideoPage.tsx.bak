                onClick={() => void stopQueue()}
                disabled={!exporting && !joining}
                className="rounded border border-rose-400/40 px-2.5 py-1.5 text-[10px] font-semibold text-rose-200 hover:bg-rose-950/40 disabled:opacity-40"
              >
