              </div>
              // (ÄÃ£ xÃ³a checkbox Æ¯u tiÃªn keyframe cÅ© táº¡i Ä‘Ã¢y)
              <button type="button" onClick={addLastCut} disabled={!queue.length} title="ThÃªm pháº§n cÃ²n láº¡i sau frame cuá»‘i cá»§a range cuá»‘i trong queue" className="rounded border border-violet-400/40 px-2 py-1 text-[11px] text-violet-200 hover:bg-violet-400/10 disabled:opacity-40">Last Cut</button>
              <button
