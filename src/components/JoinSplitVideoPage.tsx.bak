                  title="Bá» chá»n Join queues (reset náº¿u bá»‹ káº¹t)"
                  className="ml-1 p-1 rounded hover:bg-slate-700 text-[10px] text-slate-400 hover:text-slate-100 disabled:opacity-30 disabled:hover:bg-transparent"
                  aria-label="Reset Join queues"
                >
                  âœ•
                </button>
