                            />
                          </div>
                        );
                      })}
                    </div>
                    <div className="pointer-events-none absolute top-6 z-20 h-full border-l-2 border-red-500" style={{ left: `${playhead * zoom}px` }}>
                      <div className="absolute -left-[5px] top-0 h-2.5 w-2.5 rounded-b-sm bg-red-500" />
                    </div>
                  </>
                )}
